<head>
    <style>
        html{
            font-family: 'Dejavu Sans', 'Helvetica Neue', 'Helvetica', sans-serif;
            font-size: medium;
        }

        .main {
            margin-bottom: 15px;
        }

        div,
        h1,
        h2,
        h3,
        h4,
        table,
        p {
            font-family: 'Dejavu Sans', 'Helvetica Neue', 'Helvetica', sans-serif;
        }

        div,
        table,
        p {
            font-size: 1rem;
        }

        hr {
            border: 1px solid #F5A212;
        }

        h1 {
            font-size: 1.5rem;
            text-align: right;
            color: #2d2c74;
            padding: 0px;
            margin: 0px;
        }

        h2 {
            font-size: 1.3rem;
            text-align: center;
            color: #2d2c74;
            padding: 0px;
            margin: 0px 0px 10px 0px;
        }

        h3 {
            font-size: 1rem;
            text-align: center;
            color: #2d2c74;
            padding: 0px;
            margin: 0px 0px 10px 0px;
        }

        table {
            border: 1px solid black;
            border-collapse: collapse;
        }

        tr,
        td {
            vertical-align: top;
        }

        .titre {
            border-top: 1px solid black;
            border-bottom: 1px solid black;
            color: #2d2c74;
        }

        .jour {
            font-size: 0.9rem;
            color: #2d2c74;
            font-weight: bold;
        }

        .lieu {
            font-size: 0.8rem;
            color: #000000;
            font-weight: bold;
        }

        .celebrant {
            font-size: 0.8rem;
            color: #000000;
            text-align: right;
            font-style: italic;
            padding-right: 5px;
        }

        .bandeauDominicale {
            font-weight: bold;
            font-size: 1rem;
            text-align: center;
            background-color: #aaaaaa
        }

        .bandeauFete {
            font-weight: bold;
            font-size: 1rem;
            text-align: center;
            background-color: #EA6764
        }

        .footer {
            color: #2d2c74;
            text-align: center;
            font-size: 0.8rem;
            font-style: italic;
        }

        .page_break {
            page-break-after: always;
            break-after: always;
        }

        .print-date {
            position: fixed;
            bottom: 0px;
            right: 0;
            font-size: 0.5rem;
            font-style: italic;
            color: #666666;
        }
    </style>
</head>